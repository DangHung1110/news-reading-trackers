{
  "name": "news-reading-activity-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Track active news-reading sessions from Chrome and display them in a dashboard.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:extension": "pnpm --filter extension dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint e2e playwright.config.ts --max-warnings=0 && pnpm -r --if-present lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm test:e2e:api && pnpm test:e2e:system",
    "test:e2e:api": "pnpm --filter api test:e2e",
    "test:e2e:system": "playwright test",
    "demo": "node scripts/demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma": "pnpm --filter api prisma",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:reset": "pnpm --filter api prisma:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
